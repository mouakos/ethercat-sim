    { "type": "text", "id": "t_codebox", "x": 55, "y": 375, "width": 670, "height": 108,
      "text": "# Commande pour lancer le simulateur :\nec-core --serve \"\\Device\\NPF_{...}\" --slaves 4\n\n# --slaves 4  : présente EK1100 + EL1008 + EL2008 + EL3001 (stable)\n# --slaves 5  : ajoute l'EL6224 (en cours de débogage)\n# --log       : active les logs CoE détaillés pour le diagnostic",
      "originalText": "# Commande pour lancer le simulateur :\nec-core --serve \"\\Device\\NPF_{...}\" --slaves 4\n\n# --slaves 4  : présente EK1100 + EL1008 + EL2008 + EL3001 (stable)\n# --slaves 5  : ajoute l'EL6224 (en cours de débogage)\n# --log       : active les logs CoE détaillés pour le diagnostic",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 12005, "version": 1, "versionNonce": 12006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
